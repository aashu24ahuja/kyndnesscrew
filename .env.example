# Public URL of the deployed site (used for share images).
NEXT_PUBLIC_SITE_URL=https://example.org

# Supabase project (Project Settings → API). The publishable key is safe to expose;
# row-level security only allows inserting reports. See README "Report intake".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
