# Public URL of the deployed site (used for share images).
NEXT_PUBLIC_SITE_URL=https://example.org

# Google Sheet report intake — see README "Report intake".
# Web app URL from Apps Script → Deploy → Manage deployments (ends in /exec).
GOOGLE_SHEET_WEBHOOK_URL=
# Must match the SECRET script property in the Apps Script project.
GOOGLE_SHEET_SECRET=
